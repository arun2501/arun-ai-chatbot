# ==============================================================================
# Environment Configuration for Arunkumar K R's Personal Chatbot
# NOTE: The chatbot works 100% OFFLINE without any API keys required!
# If you want to connect a 100% FREE Cloud LLM (no credit card required),
# you can obtain a free key from Groq or Google Gemini below:
# ==============================================================================

# Option 1: Groq Cloud (Free Tier - Blazing fast LLaMA 3.3 70B & 3.1 8B)
# Get a free key at: https://console.groq.com/keys
GROQ_API_KEY=

# Option 2: Google Gemini (Free Tier - 1,500 requests/day, no credit card)
# Get a free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Option 3: Local Ollama (Set to true if you run `ollama run llama3.2` locally)
OLLAMA_ENABLED=false
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Server Port
PORT=5000
DEBUG=False
